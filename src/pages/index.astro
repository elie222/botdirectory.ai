---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SponsorCard from '../components/SponsorCard.astro';
import TagDialog from '../components/TagDialog.astro';
import MarqueeStrips from '../components/MarqueeStrips.astro';
import EdgeColumn from '../components/EdgeColumn.astro';
import SponsorShuffle from '../components/SponsorShuffle.astro';
import ToolIcon from '../components/ToolIcon.astro';
import Select from '../components/Select.astro';
import { FEATURES, SITE, SPONSORING } from '../config';
import { CATEGORIES, catStyle, fmt } from '../lib/constants';
import { getBots, SPONSORS, PROMOS, type Bot, type Promo } from '../lib/data';
import { categorySlug, listIntegrations, MIN_INTEGRATION_HUB_BOTS } from '../lib/seo';
import { sponsorUrl } from '../lib/utm';

const bots = [...(await getBots())].sort(
  (a, b) => b.copies - a.copies || a.name.localeCompare(b.name),
);
const integrations = listIntegrations(bots, 1);
const allTools = integrations.map(({ name }) => name).sort();
const topIntegrationHubs = integrations.filter(({ count }) => count >= MIN_INTEGRATION_HUB_BOTS).slice(0, 8);

const mode = SPONSORING.mode;
const hasRail = mode === 'rail' || mode === 'both';
const hasEdge = mode === 'both';
const pageCols = hasEdge ? '252px minmax(0, 1fr) 252px' : 'minmax(0, 1fr)';
const browseMax = mode === 'rail' ? '1460px' : '1150px';
const browseGrid = mode === 'rail' ? 'minmax(0, 1fr) 272px' : 'minmax(0, 1fr)';
const sponsorsRight = mode === 'both' ? SPONSORS : SPONSORS.slice(0, 3);
const slotsLine =
  mode === 'both'
    ? `${SPONSORING.slotsTakenBoth} of ${SPONSORING.slotsTotalBoth} spots taken`
    : `${SPONSORING.slotsTaken} of ${SPONSORING.slotsTotal} spots taken`;
const railWrapClass = mode === 'both' ? 'iz-only-narrow' : '';

// In-list sponsor mode: promoted rows spliced at fixed indexes.
type Row = { bot: Bot; promo?: undefined } | { promo: Promo; bot?: undefined };
const rows: Row[] = bots.map((b) => ({ bot: b }));
if (mode === 'inline') {
  for (const p of PROMOS) rows.splice(Math.min(p.at, rows.length), 0, { promo: p });
}

const searchText = (b: Bot) => [b.name, b.category, ...b.integrations, b.contributor].filter(Boolean).join(' ').toLowerCase();

const title = `Grok Bot Prompts & AI Bot Directory | ${SITE.wordmark}`;
const description =
  'Browse ready-to-use bot prompts for Grok Bot, Rakazo, and other AI agents. Copy a workflow, connect its tools, and launch a scheduled bot in minutes.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.wordmark,
    url: SITE.url,
    description,
    publisher: {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.wordmark,
      url: SITE.url,
      sameAs: [SITE.xUrl, SITE.repoUrl],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/#directory`,
    name: 'AI bot prompt directory',
    url: SITE.url,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: bots.length,
      itemListElement: bots.map((bot, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: bot.name,
        url: `${SITE.url}/bots/${bot.slug}/`,
      })),
    },
  },
];
---

<Base title={title} description={description} structuredData={structuredData}>
  <div class:list={['iz-page-root', { 'hide-copies': !FEATURES.showCopies }]}>
    <MarqueeStrips />

    <div class="iz-cols" style={`grid-template-columns: ${pageCols};`}>
      {hasEdge && <EdgeColumn side="left" />}

      <div style="min-width: 0;">
        <Header isHome />

        <section class="hero">
          <p class="iz-eyebrow">
            Works with <a href={SITE.grokBotUrl}>Grok Bot</a> and <a href={SITE.rakazoUrl}>Rakazo</a>
          </p>
          <h1 class="hero-title">The Grok Bot directory</h1>
          <p class="hero-sub">Bots that get stuff done. Set one up with a single prompt for work, business, or everyday life.</p>
          <nav class="discovery-links" aria-label="Browse prompt collections">
            <span>Explore:</span>
            {CATEGORIES.map((category) => <a href={`/categories/${categorySlug(category)}/`}>{category}</a>)}
            <a href="/integrations/">By integration</a>
            <a href="/collections/chief-of-staff/">Chief of Staff prompts</a>
          </nav>
          <nav class="discovery-links discovery-links-tools" aria-label="Popular integrations">
            <span>Popular tools:</span>
            {topIntegrationHubs.map((integration) => <a href={`/integrations/${integration.slug}/`}>{integration.name}</a>)}
          </nav>
        </section>

        <section id="browse" class="browse" style={`max-width: ${browseMax};`}>
          <div class="iz-browse-grid" style={`grid-template-columns: ${browseGrid};`}>
            <div style="min-width: 0;">
              <div class="filterbar">
                <div class="filterbar-controls">
                  <input type="text" id="bot-search" class="search-input" placeholder="Search" />
                  <Select
                    id="bot-category"
                    label="Filter by category"
                    options={[{ value: 'All', label: 'Any category' }, ...CATEGORIES.map((c) => ({ value: c, label: c, swatch: catStyle(c).catFg }))]}
                  />
                  <Select
                    id="bot-integration"
                    label="Filter by integration"
                    options={[{ value: 'all', label: 'Any integration' }, ...allTools.map((t) => ({ value: t, label: t, tool: t }))]}
                  />
                  <Select
                    id="bot-sort"
                    label="Sort bots"
                    value="copies"
                    options={[
                      ...(FEATURES.showCopies ? [{ value: 'copies', label: 'Most copied' }] : []),
                      { value: 'newest', label: 'Newly added' },
                      { value: 'name', label: 'A–Z' },
                    ]}
                  />
                  <div class="view-toggle">
                    <button type="button" id="view-table-btn" class="view-btn active">Table</button>
                    <button type="button" id="view-cards-btn" class="view-btn">Cards</button>
                  </div>
                </div>
              </div>

              <div id="directory-view" class="bot-table directory-view" data-view="table">
                <div class="bot-table-head">
                  <span>Bot</span><span>Category</span><span>Integrations</span>{FEATURES.showCopies && <span>Copies</span>}<span>Source</span>
                </div>
                {
                  rows.map((row) =>
                    row.bot ? (
                      <a
                        href={`/bots/${row.bot.slug}/`}
                        class="bot-row"
                        data-slug={row.bot.slug}
                        data-name={row.bot.name}
                        data-category={row.bot.category}
                        data-copies={row.bot.copies}
                        data-added-at={row.bot.addedAt}
                        data-integrations={row.bot.integrations.join('|')}
                        data-search={searchText(row.bot)}
                      >
                        <span class="bot-row-namecell">
                          <span class="bot-row-nameline">
                            <span class="bot-row-name">{row.bot.name}</span>
                          </span>
                          <span class="directory-card-summary" data-prompt-slug={row.bot.slug}>View the full prompt and setup instructions.</span>
                        </span>
                        <span
                          class="cat-pill"
                          style={`color: ${catStyle(row.bot.category).catFg}; background: ${catStyle(row.bot.category).catBg}; border-color: ${catStyle(row.bot.category).catBorder};`}
                        >{row.bot.category}</span>
                        <span class="bot-row-tools">
                          {row.bot.integrations.map((t) => (
                            <span class="bot-row-tool"><ToolIcon name={t} size={14} />{t}</span>
                          ))}
                        </span>
                        {FEATURES.showCopies && (
                          <span class="bot-row-copies" data-copies-slug={row.bot.slug} data-copies-seed={row.bot.copies}>{fmt(row.bot.copies)} copies</span>
                        )}
                        <span class="bot-row-contrib">{row.bot.contributor ? `@${row.bot.contributor}` : '—'}</span>
                      </a>
                    ) : (
                      <a
                        href={sponsorUrl(row.promo.href, 'promo')}
                        class="bot-row"
                        data-promo
                        data-sponsor={row.promo.name}
                        data-sponsor-placement="promo"
                        data-at={row.promo.at}
                        style={`background: var(--iz-${row.promo.family}-50);`}
                      >
                        <span class="bot-row-namecell">
                          <span class="bot-row-nameline">
                            <span class="bot-row-name">{row.promo.name}</span>
                            <span class="promo-tag-row">Promoted</span>
                          </span>
                          <span class="bot-row-note">{row.promo.note}</span>
                        </span>
                        <span
                          class="cat-pill"
                          style={`color: ${catStyle(row.promo.category).catFg}; background: ${catStyle(row.promo.category).catBg}; border-color: ${catStyle(row.promo.category).catBorder};`}
                        >{row.promo.category}</span>
                        <span class="bot-row-tools">
                          {row.promo.integrations.map((t) => (
                            <span class="bot-row-tool"><ToolIcon name={t} size={14} />{t}</span>
                          ))}
                        </span>
                        {FEATURES.showCopies && <span class="bot-row-copies">Sponsored</span>}
                        <span class="bot-row-contrib">@{row.promo.contributor}</span>
                      </a>
                    )
                  )
                }
              </div>

              <div id="empty-state" class="empty-state" hidden>
                <p class="empty-state-title">No bot for that yet.</p>
                <p class="empty-state-sub">Write the prompt and open a PR — or tag @botdirectoryai on X and our agent does it for you.</p>
              </div>
            </div>

            {
              hasRail && (
                <div class:list={['iz-rail-wrap', railWrapClass]}>
                  <div class="rail-head">
                    <span class="rail-label">Sponsored</span>
                    <a href="/sponsor/" class="rail-slots">{slotsLine}</a>
                  </div>
                  <aside class="iz-rail">
                    {sponsorsRight.map((s) => <SponsorCard sponsor={s} />)}
                    <a href="/sponsor/" class="slot-empty">
                      <span class="slot-empty-title">Your tool here</span>
                      <span class="slot-empty-pitch">{SPONSORING.railPitch}</span>
                    </a>
                  </aside>
                </div>
              )
            }
          </div>
        </section>
      </div>

      {hasEdge && <EdgeColumn side="right" />}
    </div>

    <section id="contribute" class="contribute-section">
      <div class="contribute-inner">
        <div>
          <p class="iz-eyebrow">Contribute</p>
          <h2 class="contribute-title">A bot is one file in a repo</h2>
          <p class="contribute-copy">
            No plugin API, no review board. Add a markdown file with the prompt and the integrations it needs, open a
            pull request, and it shows up here.
          </p>
          <div class="cta-row">
            <PrimaryButton href={SITE.repoUrl}>Open a pull request</PrimaryButton>
            <button type="button" class="btn-secondary" data-tag-open>Tag a tweet</button>
          </div>
          <a href={SITE.contributingUrl} class="contribute-guide-link">Read the contribution guide →</a>
          <p class="contribute-alt">
            No PR needed: tag <a href={SITE.xUrl}>{SITE.xHandle}</a> under any tweet about a bot setup and our
            agent does the rest.
          </p>
          <p class="contribute-alt">
            Building a bot that watches the directory? <a href="https://api.botdirectory.ai/api/bots">Use the public JSON API</a>
            — search, filter, and page through every listing.
          </p>
        </div>
        <div class="file-card">
          <div class="file-card-head">
            <span class="file-card-name">bots/seo-improver.md</span>
          </div>
          <pre class="file-card-body">---
name: SEO Improver
category: Marketing
added_at: "2026-08-18T12:00:00.000Z"
contributor: elie2222
integrations: [GitHub, DataForSEO, Search Console]
---

Set up a new bot for me. Walk me through
connecting GitHub, DataForSEO and Google
Search Console, then schedule it every 2
weeks: find pages losing impressions or
sitting on page two, rewrite titles and
metadata, fix internal links, and open a PR
I review before merge.</pre>
        </div>
      </div>
    </section>

    <section id="sponsor" class="sponsor-section">
      <div class="sponsor-inner">
        <div>
          <p class="sponsor-eyebrow">Sponsor</p>
          <h2 class="sponsor-title">Get your tool in the room</h2>
          <p class="sponsor-copy">
            This is where people decide what to build with. <a href="/sponsor/" class="sponsor-more">See placements and pricing →</a>
          </p>
        </div>
        <PrimaryButton href="/sponsor/">Sponsor</PrimaryButton>
      </div>
    </section>

    <Footer />
    <TagDialog />
  </div>

  <SponsorShuffle />
</Base>

<script>
  import '../scripts/browse';
</script>
