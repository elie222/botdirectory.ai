---
import Base from '../../layouts/Base.astro';
import SponsorCard from '../../components/SponsorCard.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import SourceEmbed from '../../components/SourceEmbed.astro';
import { CONNECT_SPONSOR, FEATURES, SITE } from '../../config';
import { catStyle, fmt } from '../../lib/constants';
import { botHasPrompt, getBots, SPONSORS, type Bot } from '../../lib/data';
import { botDescription, botLastModified, categorySlug, integrationSlug, listIntegrations, relatedBots } from '../../lib/seo';
import { sponsorUrl } from '../../lib/utm';
import { sourceContentName } from '../../lib/sources';

export async function getStaticPaths() {
  const bots = await getBots();
  const integrationHubNames = listIntegrations(bots).map(({ name }) => name);
  return bots.map((bot) => ({ params: { slug: bot.slug }, props: { bot, bots, integrationHubNames } }));
}

interface Props {
  bot: Bot;
  bots: Bot[];
  integrationHubNames: string[];
}

const { bot, bots, integrationHubNames } = Astro.props;
const cat = catStyle(bot.category);
const primarySource = bot.sources[0];
const integrationHubs = new Set(integrationHubNames);
const related = relatedBots(bot, bots);
const hasPrompt = botHasPrompt(bot);
const listingBlurb = bot.description?.trim() || '';
const title = hasPrompt ? `${bot.name} Grok Bot Prompt` : `${bot.name} Grok Bot`;
const description = botDescription(bot);
const pageUrl = `${SITE.url}/bots/${bot.slug}/`;
const categoryUrl = `${SITE.url}/categories/${categorySlug(bot.category)}/`;
const isChiefOfStaff = bot.slug.includes('chief-of-staff');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: hasPrompt ? `${bot.name} bot prompt` : `${bot.name} bot`,
    url: pageUrl,
    description,
    genre: bot.category,
    keywords: [
      bot.category,
      ...bot.integrations,
      ...(hasPrompt ? ['AI bot prompt', 'Grok Bot prompt'] : ['Grok Bot', 'AI bot']),
    ],
    ...(bot.sources.length && { citation: bot.sources.map((source) => source.url) }),
    ...(bot.grokShareUrl && { sameAs: bot.grokShareUrl }),
    isAccessibleForFree: true,
    datePublished: bot.addedAt,
    dateModified: botLastModified(bot),
    isPartOf: { '@type': 'WebSite', name: SITE.wordmark, url: SITE.url },
    ...(bot.contributor && {
      creator: {
        '@type': 'Person',
        name: bot.contributor,
        url: bot.contributorUrl ?? `https://github.com/${bot.contributor}`,
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'All bots', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: bot.category, item: categoryUrl },
      { '@type': 'ListItem', position: 3, name: bot.name, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={description} type="article" structuredData={structuredData}>
  <Header />

  <article class="bot-article" data-slug={bot.slug}>
    <div class="breadcrumb">
      <a href="/">All bots</a>
      <span>/</span>
      <a href={`/categories/${categorySlug(bot.category)}/`}>{bot.category}</a>
    </div>

    <h1 class="bot-title">{bot.name}</h1>

    <div class="badge-row">
      <span class="badge-cat" style={`color: ${cat.catFg}; background: ${cat.catBg}; border-color: ${cat.catBorder};`}>{bot.category}</span>
      {FEATURES.showCopies && hasPrompt && (
        <span class="badge-plain" data-copies-slug={bot.slug} data-copies-seed={bot.copies}>{fmt(bot.copies)} copies</span>
      )}
      {
        (bot.contributor || primarySource || bot.scoutedBy) && (
          <span class="attribution">
          {primarySource ? (
            <>
              Based on <a href={primarySource.url}>this {sourceContentName(primarySource.kind)}</a>
              {bot.contributor && (
                <>
                  {' by '}
                  <a href={bot.contributorUrl ?? (primarySource.kind === 'x' ? `https://x.com/${bot.contributor}` : `https://github.com/${bot.contributor}`)}>@{bot.contributor}</a>
                </>
              )}
            </>
          ) : (
            bot.contributor && (
              <>
                Contributed by{' '}
                <a href={bot.contributorUrl ?? `https://github.com/${bot.contributor}`}>@{bot.contributor}</a>
              </>
            )
          )}
          {bot.scoutedBy && (
            <>
              {' · scouted by '}
              <a href={`https://x.com/${bot.scoutedBy}`}>@{bot.scoutedBy}</a>
            </>
          )}
          </span>
        )
      }
    </div>

    {
      hasPrompt ? (
        <section class="prompt-section">
          <div class="prompt-head">
            <h2 class="section-title">The prompt</h2>
            <div class="prompt-head-actions">
              {
                bot.grokShareUrl && (
                  <a
                    href={bot.grokShareUrl}
                    class="add-grok-btn"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-grok-share
                  >
                    Add to Grok Bot
                  </a>
                )
              }
              <button type="button" class="copy-btn" data-copy-slug={bot.slug} data-copied-label="Copied">Copy prompt</button>
            </div>
          </div>
          {listingBlurb && <p class="listing-description">{listingBlurb}</p>}
          <div class="prompt-block" id="prompt-block">{bot.prompt}</div>
        </section>
      ) : (
        <section class="prompt-section">
          <div class="prompt-head">
            <h2 class="section-title">Description</h2>
            <div class="prompt-head-actions">
              {
                bot.grokShareUrl && (
                  <a
                    href={bot.grokShareUrl}
                    class="add-grok-btn"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-grok-share
                  >
                    Add to Grok Bot
                  </a>
                )
              }
            </div>
          </div>
          <div class="prompt-block description-block">{listingBlurb}</div>
          <p class="section-note">
            This is the public description from the bot's share page — not a copy-paste system prompt.
            Use <strong>Add to Grok Bot</strong> for the official setup.
          </p>
        </section>
      )
    }

    <section class="connect-section">
      <h2 class="section-title">Connect first</h2>
      <div class="connect-chips">
        {
          bot.integrations.map((t) => (
            integrationHubs.has(t) ? (
              <a href={`/integrations/${integrationSlug(t)}/`} class="connect-chip"><ToolIcon name={t} size={18} />{t}</a>
            ) : (
              <span class="connect-chip"><ToolIcon name={t} size={18} />{t}</span>
            )
          ))
        }
      </div>
      <p class="section-note">
        {hasPrompt
          ? 'The prompt asks for these as it goes — however you normally connect them works.'
          : 'Connect these in Grok Bot after you add the official share link — however you normally connect them works.'}
      </p>
      {
        CONNECT_SPONSOR.enabled && (
          <a
            href={sponsorUrl(CONNECT_SPONSOR.url, 'connect')}
            class="connect-sponsor"
            data-sponsor={CONNECT_SPONSOR.name}
            data-sponsor-placement="connect"
            rel="sponsored"
          >
            <img src={CONNECT_SPONSOR.logo} alt={`${CONNECT_SPONSOR.name} logo`} width="128" height="128" class="connect-sponsor-logo" loading="lazy" />
            <span class="connect-sponsor-copy">
              {CONNECT_SPONSOR.copy} <span class="connect-sponsor-cta">{CONNECT_SPONSOR.cta}</span>
            </span>
            <span class="connect-sponsor-label">Sponsored</span>
          </a>
        )
      }
    </section>

    {
      hasPrompt ? (
        <section class="setup-section">
          <h2 class="section-title">How to use this prompt</h2>
          <ol class="setup-steps">
            <li><strong>Copy the full prompt.</strong> Keep the instructions together so the agent sees the workflow, tools, and guardrails.</li>
            <li><strong>Paste it into your agent.</strong> Answer the setup questions and connect {bot.integrations.length === 1 ? 'the required tool' : 'the required tools'} when asked.</li>
            <li><strong>Review the first run.</strong> Confirm the output and approval rules before saving it for on-demand or scheduled use.</li>
          </ol>
          {isChiefOfStaff && <p class="section-note"><a href="/collections/chief-of-staff/">Compare every Chief of Staff prompt</a> by job, cadence, and integrations.</p>}
        </section>
      ) : (
        <section class="setup-section">
          <h2 class="section-title">How to use this bot</h2>
          <ol class="setup-steps">
            <li><strong>Open the official share link.</strong> Use Add to Grok Bot — we only link the creator's x.ai share URL.</li>
            <li><strong>Add it to your account.</strong> Preview on x.ai, then add a copy to your Grok Bot workspace.</li>
            <li><strong>Connect tools and review.</strong> Wire up {bot.integrations.length === 1 ? 'the required tool' : 'the required tools'} and confirm behavior before trusting scheduled or consequential actions.</li>
          </ol>
          {isChiefOfStaff && <p class="section-note"><a href="/collections/chief-of-staff/">Compare every Chief of Staff listing</a> by job, cadence, and integrations.</p>}
        </section>
      )
    }

    <section class="cta-card">
      <div>
        <p class="cta-title">Run {bot.name} yourself</p>
        <p class="cta-sub">
          {bot.grokShareUrl && hasPrompt
            ? 'Add via the official Grok Bot share link, or copy the prompt and adapt it.'
            : bot.grokShareUrl
              ? 'Add via the official Grok Bot share link.'
              : 'Free to copy, adapt, and edit after setup.'}
        </p>
      </div>
      <div class="cta-actions">
        {
          bot.grokShareUrl && (
            <div class="pbtn-wrap">
              <a
                href={bot.grokShareUrl}
                class="pbtn pbtn-44"
                target="_blank"
                rel="noopener noreferrer"
                data-grok-share
              >
                Add to Grok Bot
              </a>
            </div>
          )
        }
        {
          hasPrompt && (
            <div class="pbtn-wrap">
              <button type="button" class="pbtn pbtn-44" data-copy-slug={bot.slug} data-copied-label="Copied — now open your agent">Copy and set up</button>
            </div>
          )
        }
        <a href={`${SITE.repoUrl}/blob/main/bots/${bot.slug}.md`} class="btn-view-source">View source</a>
      </div>
    </section>

    {
      bot.sources.length > 0 && (
        <section class="source-section">
          <div class="source-section-head">
            <h2 class="section-title">Original {bot.sources.length === 1 ? 'source' : 'sources'}</h2>
            <a href="/sources/" class="source-section-all">Browse all sources</a>
          </div>
          <div class="source-section-embeds">
            {bot.sources.map((source) => <SourceEmbed source={source} />)}
          </div>
        </section>
      )
    }

    <section class="reviews-section" id="reviews" data-slug={bot.slug}>
      <div class="reviews-head">
        <h2 class="section-title">Reviews</h2>
        <p class="reviews-summary" data-reviews-summary hidden></p>
      </div>
      <ul class="reviews-list" data-reviews-list hidden></ul>
      <div class="reviews-api-row">
        <p class="reviews-api-note">Tell your bot to comment via API.</p>
        <button
          type="button"
          class="reviews-api-btn"
          data-reviews-copy
          title="Copy curl to post a review"
        >POST /v1/bots/{bot.slug}/reviews</button>
      </div>
    </section>

    <section class="related-section">
      <h2 class="section-title">Related bot prompts</h2>
      <div class="related-grid">
        {
          related.map((x) => (
            <a href={`/bots/${x.slug}/`} class="related-card">
              <span class="related-name">{x.name}</span>
              <span class="related-meta">
                {x.integrations.slice(0, 2).join(', ')}{FEATURES.showCopies && botHasPrompt(x) && (
                  <> · <span data-copies-slug={x.slug} data-copies-seed={x.copies}>{fmt(x.copies)} copies</span></>
                )}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <p class="more-in-category">Browse all <a href={`/categories/${categorySlug(bot.category)}/`}>{bot.category.toLowerCase()} Grok Bot prompts</a>.</p>

    <section class="page-sponsors">
      <div class="page-sponsors-head">
        <span class="page-sponsors-label">Sponsored</span>
        <a href="/sponsor/" class="page-sponsors-cta">advertise →</a>
      </div>
      <div class="page-sponsors-grid" id="page-sponsors-grid">
        {SPONSORS.map((s) => <SponsorCard sponsor={s} placement="bot-page" />)}
      </div>
    </section>
  </article>

  <!-- Keep 3 random sponsors per page load; the rest are removed pre-paint. -->
  <script is:inline>
    (() => {
      const grid = document.getElementById('page-sponsors-grid');
      if (!grid) return;
      const cards = [...grid.children];
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.slice(3).forEach((c) => c.remove());
      cards.slice(0, 3).forEach((c) => grid.appendChild(c));
    })();
  </script>

  <Footer />
</Base>

{
  hasPrompt && (
    <script>
      import { loadCopyCounts, trackCopy, refreshCopyLabels } from '../../scripts/copies';
      import { mountReviews } from '../../scripts/reviews';

      const promptBlock = document.getElementById('prompt-block');
      const prompt = promptBlock?.textContent ?? '';
      const buttons = document.querySelectorAll<HTMLElement>('[data-copy-slug]');

      buttons.forEach((btn) =>
        btn.addEventListener('click', () => {
          if (navigator.clipboard && prompt) navigator.clipboard.writeText(prompt).catch(() => {});
          trackCopy(btn.dataset.copySlug || '');
          buttons.forEach((b) => {
            b.textContent = b.dataset.copiedLabel || 'Copied';
          });
          refreshCopyLabels();
        })
      );

      refreshCopyLabels();
      void loadCopyCounts();

      const reviewsRoot = document.querySelector<HTMLElement>('#reviews');
      if (reviewsRoot) mountReviews(reviewsRoot);
    </script>
  )
}

{
  !hasPrompt && (
    <script>
      import { mountReviews } from '../../scripts/reviews';

      const reviewsRoot = document.querySelector<HTMLElement>('#reviews');
      if (reviewsRoot) mountReviews(reviewsRoot);
    </script>
  )
}
